{
  "name": "simple-workout",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && node scripts/import-exercise-media.mjs check && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "media:import": "node scripts/import-exercise-media.mjs import",
    "media:review": "node scripts/build-media-review.mjs",
    "media:verify": "node scripts/import-exercise-media.mjs verify",
    "media:check": "node scripts/import-exercise-media.mjs check"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.46.1-build3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^3.2.7"
  }
}
